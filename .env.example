# Copy this file to .env and fill in your tokens.
# Get a token at:
# https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
#
# Add as many USER_<n>_NAME / USER_<n>_TOKEN pairs as you need.
# Numbering must start at 1 and be consecutive (discovery stops at first missing pair).

USER_1_NAME=Alice
USER_1_TOKEN=your_token_here

USER_2_NAME=Bob
USER_2_TOKEN=your_token_here

# USER_3_NAME=Carol
# USER_3_TOKEN=your_token_here
